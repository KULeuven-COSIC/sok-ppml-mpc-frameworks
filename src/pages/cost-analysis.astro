---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { readFileSync } from 'fs'
import { join } from 'path'
import { cleanName as cleanProtocol, getRefNum } from '../scripts/parseTable.mjs'

function parseCostTable(filePath) {
  try {
    const content = readFileSync(join(process.cwd(), filePath), 'utf-8')
    const lines = content.split('\n')
    const tableLines = []
    let inTable = false
    for (const line of lines) {
      if (line.trim().startsWith('|')) { inTable = true; tableLines.push(line.trim()) }
      else if (inTable && line.trim() === '') break
    }
    if (tableLines.length < 3) return { headers: [], rows: [] }
    const headers = tableLines[0].split('|').slice(1, -1).map(h => h.trim())
    const rows = tableLines.slice(2).map(line => {
      const cells = line.split('|').slice(1, -1).map(c => c.trim())
      const obj = {}
      headers.forEach((h, i) => { obj[h] = cells[i] ?? '' })
      return obj
    })
    return { headers, rows }
  } catch { return { headers: [], rows: [] } }
}

const base = import.meta.env.BASE_URL
function getPaperUrl(cell) {
  const m = (cell || '').match(/references\.md#([^)]+)/)
  if (m) return `${base}/bibliography#${m[1]}`
  return null
}

const operations = [
  { id: 'relu', label: 'ReLU', icon: 'ph-lightning', color: 'text-orange-400', desc: 'Rectified Linear Unit' },
  { id: 'dot-product', label: 'Dot Product', icon: 'ph-brackets-square', color: 'text-blue-400', desc: 'Linear layer' },
  { id: 'truncation', label: 'Truncation', icon: 'ph-scissors', color: 'text-teal-400', desc: 'Fixed-point rounding' },
  { id: 'softmax', label: 'Softmax', icon: 'ph-chart-pie', color: 'text-purple-400', desc: 'Softmax activation' },
  { id: 'sigmoid', label: 'Sigmoid', icon: 'ph-wave-sine', color: 'text-pink-400', desc: 'Sigmoid activation' },
  { id: 'gelu', label: 'GELU', icon: 'ph-wave-triangle', color: 'text-emerald-400', desc: 'Gaussian ELU' },
  { id: 'normalization', label: 'Norm.', icon: 'ph-equalizer', color: 'text-amber-400', desc: 'Normalization' },
]

const FIXED_COLS = ['N', 'Sec.', 'Protocol']

const tables = {}
for (const op of operations) {
  const { headers, rows } = parseCostTable(`Tables/Theoretical-analysis/theoretical-analysis-${op.id}.md`)
  const dataHeaders = headers.filter(h => !FIXED_COLS.includes(h))
  tables[op.id] = {
    dataHeaders,
    rows: rows.map(r => {
      const obj = {
        _N: r['N'] || '—',
        _sec: r['Sec.'] || '—',
        _protocol: cleanProtocol(r['Protocol'] || ''),
        _paperUrl: getPaperUrl(r['Protocol'] || ''),
        _refNum: getRefNum(r['Protocol'] || ''),
      }
      dataHeaders.forEach(h => { obj[h] = r[h] || '—' })
      return obj
    })
  }
}

const tablesJson = JSON.stringify(tables)
const opsJson = JSON.stringify(operations)
---

<Layout title="Cost Analysis">
  <Navbar slot="navbar" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="section-heading">Theoretical Cost Analysis</h1>
      <p class="section-subheading">
        Communication costs in total bits. Select an operation to compare protocols.
        Formulas rendered with <a href="https://katex.org" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:underline">KaTeX</a>.
      </p>
    </div>

    <script define:vars={{ tablesJson, opsJson }}>
      window.__COST_TABLES__ = JSON.parse(tablesJson)
      window.__OPERATIONS__ = JSON.parse(opsJson)
    </script>

    <div
      x-data="costAnalysis()"
      x-cloak
    >
      <!-- Operation selector -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2 mb-6">
        <template x-for="op in ops" :key="op.id">
          <button
            x-on:click="activeOp = op.id; filterN = 'all'; filterSec = 'all'"
            :class="activeOp === op.id
              ? 'bg-brand-500/15 border-brand-500/50 text-brand-400'
              : 'bg-navy-800 border-slate-700/50 text-slate-400 hover:border-slate-500 hover:text-slate-200'"
            class="border rounded-xl p-3 text-left transition-colors"
          >
            <i :class="op.icon + ' ' + op.color + ' text-lg block mb-1'"></i>
            <div class="text-xs font-semibold" x-text="op.label"></div>
            <div class="text-xs text-slate-600 mt-0.5 leading-tight hidden sm:block" x-text="op.desc"></div>
          </button>
        </template>
      </div>

      <!-- Filters -->
      <div class="bg-navy-800 border border-slate-700/50 rounded-xl p-4 mb-4 flex flex-wrap gap-3 items-center">
        <span class="text-slate-400 text-sm font-medium">Filter:</span>
        <select x-model="filterN" class="input-field w-auto">
          <option value="all">All parties</option>
          <option value="2">2-Party</option>
          <option value="3">3-Party</option>
          <option value="4">4-Party</option>
          <option value="N">N-Party</option>
        </select>
        <select x-model="filterSec" class="input-field w-auto">
          <option value="all">All security</option>
          <option value="SH">Semi-Honest</option>
          <option value="A">Active</option>
          <option value="F">Full</option>
          <option value="R">Robust</option>
        </select>
        <span class="ml-auto text-xs text-slate-500" x-text="currentRows.length + ' protocols'"></span>
      </div>

      <!-- View toggle -->
      <div class="flex items-center gap-2 mb-3">
        <span class="text-slate-500 text-xs font-medium">View:</span>
        <button
          x-on:click="chartMode = false"
          :class="!chartMode ? 'bg-brand-500/15 border-brand-500/50 text-brand-400' : 'bg-navy-800 border-slate-700/50 text-slate-400 hover:border-slate-500 hover:text-slate-200'"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-medium transition-colors"
        >
          <i class="ph-table text-sm"></i> Table
        </button>
        <button
          x-on:click="chartMode = true"
          :class="chartMode ? 'bg-brand-500/15 border-brand-500/50 text-brand-400' : 'bg-navy-800 border-slate-700/50 text-slate-400 hover:border-slate-500 hover:text-slate-200'"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-medium transition-colors"
        >
          <i class="ph-chart-bar-horizontal text-sm"></i> Chart
        </button>
      </div>

      <!-- Table -->
      <div x-show="!chartMode" class="overflow-x-auto rounded-xl border border-slate-700/50">
        <table class="data-table">
          <thead>
            <tr>
              <th class="text-center w-10">N</th>
              <th class="w-20">Security</th>
              <th>Protocol</th>
              <template x-for="h in currentDataHeaders" :key="h">
                <th x-text="h"></th>
              </template>
            </tr>
          </thead>
          <tbody>
            <template x-for="(row, idx) in currentRows" :key="idx">
              <tr>
                <td class="text-center font-mono text-slate-300 text-sm" x-text="row._N"></td>
                <td>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700" x-text="row._sec"></span>
                </td>
                <td>
                  <div class="flex items-center gap-1.5">
                    <span class="font-medium text-slate-200 text-sm" x-html="renderProtocol(row._protocol)"></span>
                    <template x-if="row._paperUrl && row._refNum">
                      <a :href="row._paperUrl" class="text-brand-400 hover:text-brand-300 transition-colors text-xs font-mono flex-shrink-0" x-text="'[' + row._refNum + ']'">

                      </a>
                    </template>
                  </div>
                </td>
                <template x-for="h in currentDataHeaders" :key="h">
                  <td class="text-xs">
                    <template x-if="isTechCol(h)">
                      <span x-html="techClass(row[h])"></span>
                    </template>
                    <template x-if="!isTechCol(h)">
                      <span class="font-mono text-slate-300" x-html="renderLatex(row[h])"></span>
                    </template>
                  </td>
                </template>
              </tr>
            </template>
            <template x-if="currentRows.length === 0">
              <tr>
                <td :colspan="3 + currentDataHeaders.length" class="text-center py-8 text-slate-500">
                  No protocols match the current filters.
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Chart -->
      <div x-show="chartMode" class="overflow-x-auto rounded-xl border border-slate-700/50 bg-navy-800/60 p-5">
        <div class="mb-3 flex items-center gap-2 text-xs text-slate-500">
          <i class="ph-chart-bar-horizontal text-brand-400"></i>
          <span>Online communication cost — bar width proportional to cost expression length (rough proxy). Color indicates tech type.</span>
        </div>
        <template x-if="currentRows.length === 0">
          <div class="text-center py-8 text-slate-500 text-sm">No protocols match the current filters.</div>
        </template>
        <template x-if="currentRows.length > 0">
          <div class="space-y-2.5 min-w-[480px]">
            <template x-for="(row, idx) in chartRows" :key="idx">
              <div class="flex items-center gap-3">
                <!-- N badge -->
                <span
                  class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold border border-slate-600 bg-slate-800 text-slate-300"
                  x-text="row._N"
                ></span>
                <!-- Protocol name -->
                <span
                  class="flex-shrink-0 w-36 text-xs text-slate-300 font-medium truncate"
                  :title="row._protocol"
                  x-text="row._protocol.length > 22 ? row._protocol.slice(0, 22) + '…' : row._protocol"
                ></span>
                <!-- Bar track -->
                <div class="flex-1 flex items-center gap-2 min-w-0">
                  <div class="flex-1 bg-slate-800 rounded-full h-5 overflow-hidden relative">
                    <div
                      class="h-full rounded-full transition-all duration-500"
                      :style="'width:' + row._barPct + '%;' + 'background-color:' + row._barColor + ';opacity:0.85'"
                    ></div>
                  </div>
                  <!-- Cost label -->
                  <span
                    class="flex-shrink-0 text-xs font-mono text-slate-400 w-48 truncate"
                    :title="row._onlineCost"
                    x-html="renderLatex(row._onlineCost)"
                  ></span>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>

      <!-- Notation -->
      <div class="mt-6 bg-navy-800/60 border border-slate-700/40 rounded-xl p-5">
        <h3 class="text-slate-300 font-semibold text-sm mb-3 flex items-center gap-2">
          <i class="ph-info text-brand-400"></i>
          Notation
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2 text-xs text-slate-500" id="notation-grid">
          <div set:html="$\\ell$ — bit length of secret-shared values" />
          <div set:html="$n$ — number of elements (e.g. vector length)" />
          <div set:html="$\\Lambda$ — computational security parameter" />
          <div set:html="$\\kappa$ — statistical security parameter" />
          <div set:html="$\\mu, \\nu$ — mantissa/exponent bit lengths" />
          <div set:html={"$CT_{\\\\text{BFV}}, CT_{\\\\text{CKKS}}, CT_{\\\\text{Pai}}$ \u2014 ciphertext sizes"} />
          <div set:html={"$\\\\mathcal{O}(\\\\cdot)$ \u2014 asymptotic notation"} />
          <div>&#8212; denotes no offline phase / not applicable</div>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script is:inline>
document.addEventListener('alpine:init', () => {
  Alpine.data('costAnalysis', () => ({
    tables: window.__COST_TABLES__,
    ops: window.__OPERATIONS__,
    activeOp: 'relu',
    filterN: 'all',
    filterSec: 'all',
    chartMode: false,

    get currentDataHeaders() {
      return this.tables[this.activeOp]?.dataHeaders || []
    },

    get currentRows() {
      const rows = this.tables[this.activeOp]?.rows || []
      return rows.filter(r => {
        if (this.filterN !== 'all' && String(r._N).trim() !== this.filterN) return false
        if (this.filterSec !== 'all' && !r._sec.includes(this.filterSec)) return false
        return true
      })
    },

    renderLatex(str) {
      if (!str || str === '—' || str === '-' || str === '') {
        return '<span class="text-slate-600">—</span>'
      }
      if (typeof window.katex === 'undefined') return str
      try {
        return str.replace(/\$([^$]+)\$/g, (_, tex) =>
          window.katex.renderToString(tex, { throwOnError: false, displayMode: false })
        )
      } catch (e) { return str }
    },

    renderProtocol(str) {
      if (!str) return ''
      if (typeof window.katex === 'undefined') return str
      try {
        return str.replace(/\$([^$]+)\$/g, (_, tex) =>
          window.katex.renderToString(tex, { throwOnError: false, displayMode: false })
        )
      } catch (e) { return str }
    },

    get chartRows() {
      const rows = this.currentRows
      // Find the online cost column (prefer "Online" or first non-tech, non-N, non-Sec, non-Protocol col)
      const headers = this.currentDataHeaders
      const onlineHeader = headers.find(h => /online/i.test(h)) || headers.find(h => !this.isTechCol(h)) || headers[0]
      if (!onlineHeader) return []

      // Tech type color map
      const techColorMap = { SS: '#3b82f6', OT: '#a855f7', HE: '#f97316', GC: '#ec4899', FSS: '#10b981', LUT: '#f59e0b' }
      const defaultColor = '#64748b'

      const techHeader = headers.find(h => this.isTechCol(h))

      // Compute bar widths based on cost string length as rough proxy
      const lengths = rows.map(r => {
        const cost = r[onlineHeader] || '—'
        // Strip LaTeX markup for length heuristic
        const raw = cost.replace(/\$[^$]*\$/g, m => m.slice(1, -1)).replace(/\\[a-zA-Z]+\{[^}]*\}/g, s => s).replace(/[\\{}$]/g, '')
        return raw === '—' ? 1 : Math.max(raw.length, 1)
      })
      const maxLen = Math.max(...lengths, 1)

      return rows.map((r, i) => {
        const cost = r[onlineHeader] || '—'
        const techVal = techHeader ? (r[techHeader] || '') : ''
        const firstTech = techVal.split(/[,\s]+/).map(p => p.trim()).find(p => p in techColorMap)
        const barColor = firstTech ? techColorMap[firstTech] : defaultColor
        const barPct = Math.max(Math.round((lengths[i] / maxLen) * 100), 4)
        return { ...r, _onlineCost: cost, _barPct: barPct, _barColor: barColor }
      })
    },

    isTechCol(h) {
      return h.toLowerCase().startsWith('tech')
    },

    techClass(t) {
      const techMap = { SS: 'tech-SS', OT: 'tech-OT', HE: 'tech-HE', GC: 'tech-GC', FSS: 'tech-FSS', LUT: 'tech-LUT' }
      const parts = (t || '').split(/[,\s]+/).map(p => p.trim()).filter(Boolean)
      if (parts.length === 0) return 'tech-badge bg-slate-700 text-slate-300'
      const badges = parts.map(p => {
        const cls = techMap[p] || 'bg-slate-700 text-slate-300'
        return '<span class="tech-badge ' + cls + '">' + p + '</span>'
      })
      return badges.join(' ')
    },

    init() {
      this.$nextTick(() => {
        if (typeof window.renderMathInElement !== 'undefined') {
          renderMathInElement(document.getElementById('notation-grid'), {
            delimiters: [{ left: '$', right: '$', display: false }],
            throwOnError: false
          })
        }
      })
    }
  }))
})
</script>
