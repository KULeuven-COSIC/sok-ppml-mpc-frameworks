---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { readFileSync } from 'fs'
import { join } from 'path'

const base = import.meta.env.BASE_URL

// Maps a raw "Parties" cell (e.g. "2", "3/4", "N<sup>D</sup>") to the grid's
// party-count buckets. Superscript annotations (†/D/C) are stripped first —
// they mark security-model nuances, not party counts.
function partyBuckets(raw: string): string[] {
  const stripped = raw.replace(/<sup>.*?<\/sup>/g, '')
  const tokens = stripped.match(/\d+|N/g) || []
  const buckets = new Set<string>()
  for (const t of tokens) {
    if (t === '2') buckets.add('2PC')
    else if (t === '3') buckets.add('3PC')
    else if (t === '4') buckets.add('4PC')
    else buckets.add('nPC')
  }
  return buckets.size ? [...buckets] : ['nPC']
}

// Maps the table's long descriptive Category strings to short slugs used for
// styling (e.g. the transformer sparkle badge).
function categorySlug(raw: string): string {
  const c = raw.toLowerCase()
  if (c.includes('transformer')) return 'transformer'
  if (c.includes('hybrid')) return 'hybrid'
  if (c.includes('masking')) return 'masking'
  if (c.includes('additive')) return 'additive'
  return 'other'
}

function parseGenealogyMd(content: string) {
  const nodes: { id: string; name: string; year: number; parties: string; partyBuckets: string[]; malicious: boolean; category: string; categorySlug: string }[] = []
  const edges: { from: string; to: string; type: string }[] = []

  let section = ''
  for (const raw of content.split('\n')) {
    const line = raw.trim()
    if (line.startsWith('#### Nodes')) { section = 'nodes'; continue }
    if (line.startsWith('#### Edges')) { section = 'edges'; continue }
    if (!line.startsWith('|') || /^\|\s*[-:]+/.test(line)) continue

    const cells = line.split('|').slice(1, -1).map(c => c.trim())
    if (section === 'nodes' && cells.length >= 5 && cells[0] !== 'Framework') {
      // Extract name and strip citation: "ABY [57](url)" -> "ABY"
      const nameRaw = cells[0]
      const name = nameRaw.replace(/\s*\[+\d+\]+\([^)]+\)/, '').trim()
      if (!name) continue
      const id = name.replace(/\s+/g, '')  // "Fantastic Four" -> "FantasticFour"
      const year = parseInt(cells[1]) || 0
      const rawParties = cells[2]
      const parties = rawParties.replace(/<\/?sup>/g, '') // keep annotation letter, drop the tag
      const category = cells[4]
      nodes.push({
        id, name, year,
        parties,
        partyBuckets: partyBuckets(rawParties),
        malicious: cells[3] === '✓',
        category,
        categorySlug: categorySlug(category),
      })
    } else if (section === 'edges' && cells.length >= 2 && cells[0] !== 'From') {
      const fromName = cells[0].trim()
      const toName   = cells[1].trim()
      const fromId = fromName.replace(/\s+/g, '')
      const toId   = toName.replace(/\s+/g, '')
      // No "type" column currently exists in the source table; default to 'extends'
      // so the arrow still renders, and pick up a real value if one is added later.
      const type = cells[2] ? cells[2].trim().toLowerCase() : 'extends'
      edges.push({ from: fromId, to: toId, type })
    }
  }
  return { nodes, edges }
}

let genealogyData = { nodes: [] as any[], edges: [] as any[] }
try {
  const raw = readFileSync(join(process.cwd(), 'Tables/Genealogy/genealogy.md'), 'utf-8')
  genealogyData = parseGenealogyMd(raw)
} catch (e) {}

const dataJson = JSON.stringify(genealogyData)
const baseUrl = base

const nodeYears = genealogyData.nodes.map(n => n.year).filter(Boolean)
const minYear = nodeYears.length ? Math.min(...nodeYears) : 2015
const maxYear = nodeYears.length ? Math.max(...nodeYears) : new Date().getFullYear()
---

<Layout title="Protocol Genealogy" description={`Lineage and evolution of MPC-based PPML frameworks from ${minYear} to ${maxYear}.`}>
  <Navbar slot="navbar" />

  <script define:vars={{ dataJson, baseUrl }}>
    window.__GENEALOGY__ = JSON.parse(dataJson)
    window.__BASE__ = baseUrl
  </script>

  <section class="pt-24 pb-6 px-4 max-w-7xl mx-auto">
    <h1 class="section-heading flex items-center gap-3">
      <i class="ph ph-tree-structure text-brand-400"></i>
      Protocol Genealogy
    </h1>
    <p class="section-subheading max-w-2xl">
      How MPC-based PPML frameworks have evolved and influenced each other from {minYear} to {maxYear}.
      Arrows show lineage — <em>extends</em> (solid) or <em>inspires</em> (dashed).
    </p>
  </section>

  <section
    class="px-4 pb-24 max-w-7xl mx-auto"
    x-data="genealogy()"
    x-init="init()"
  >
    <!-- Controls -->
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <!-- Party filters -->
      <div class="flex items-center gap-1 bg-navy-800 border border-slate-700/50 rounded-lg p-1">
        <template x-for="p in partyTypes" :key="p.id">
          <button
            class="px-3 py-1.5 rounded-md text-xs font-semibold transition-all"
            :class="activeParties.has(p.id)
              ? 'text-white shadow-sm ' + p.activeBg
              : 'text-slate-500 hover:text-slate-300'"
            @click="toggleParty(p.id)"
            x-text="p.label"
          ></button>
        </template>
      </div>

      <!-- Edge toggle -->
      <button
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all"
        :class="showEdges
          ? 'bg-brand-500/20 border-brand-500/50 text-brand-300'
          : 'bg-navy-800 border-slate-700/50 text-slate-400 hover:text-slate-200'"
        @click="showEdges = !showEdges"
      >
        <i class="ph ph-graph"></i>
        <span x-text="showEdges ? 'Hide lineage' : 'Show lineage'"></span>
      </button>

      <!-- Legend -->
      <div class="flex items-center gap-4 ml-auto text-xs text-slate-500">
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-6 border-t-2 border-slate-300"></span>
          extends
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-6 border-t-2 border-dashed border-slate-500"></span>
          inspires
        </span>
      </div>
    </div>

    <!-- Timeline grid wrapper (scrollable) -->
    <div class="relative overflow-x-auto rounded-xl border border-slate-700/50 bg-navy-900/40">

      <!-- SVG overlay for edges -->
      <svg
        id="genealogy-svg"
        class="absolute inset-0 pointer-events-none z-10"
        style="width:100%;height:100%;overflow:visible;"
        x-show="showEdges"
      >
        <defs>
          <marker id="arrow-extends" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#64748b" />
          </marker>
          <marker id="arrow-inspires" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#94a3b8" opacity="0.6" />
          </marker>
          <marker id="arrow-extends-hi" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#38bdf8" />
          </marker>
          <marker id="arrow-inspires-hi" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#38bdf8" opacity="0.8" />
          </marker>
        </defs>
        <g id="genealogy-edges"></g>
      </svg>

      <!-- Column headers -->
      <div class="grid sticky top-0 z-20 bg-navy-950/95 backdrop-blur border-b border-slate-700/50"
           style="grid-template-columns: 56px repeat(4, 1fr);">
        <div class="px-3 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Year</div>
        <template x-for="col in columns" :key="col.id">
          <div
            class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-center"
            :class="col.headerClass"
            x-text="col.label"
          ></div>
        </template>
      </div>

      <!-- Year rows -->
      <template x-for="year in years" :key="year">
        <div
          class="grid border-b border-slate-800/40 last:border-0"
          style="grid-template-columns: 56px repeat(4, 1fr); min-height: 64px;"
          :class="year % 2 === 0 ? 'bg-navy-900/20' : 'bg-transparent'"
        >
          <!-- Year label -->
          <div class="flex items-center justify-center px-2 py-3">
            <span
              class="text-xs font-bold tabular-nums"
              :class="hasNodesInYear(year) ? 'text-slate-400' : 'text-slate-700'"
              x-text="year"
            ></span>
          </div>

          <!-- Party columns -->
          <template x-for="col in columns" :key="col.id">
            <div class="flex flex-wrap items-center justify-center gap-1.5 px-2 py-2">
              <template x-for="node in nodesInCell(year, col.id)" :key="node.id">
                <button
                  :id="'node-' + node.id"
                  class="node-pill relative inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold transition-all border"
                  :class="[
                    col.pillClass,
                    hoveredNode === node.id ? 'ring-2 ring-sky-400 scale-110 z-10' : '',
                    hoveredNode && hoveredNode !== node.id && !connectedTo(node.id) ? 'opacity-30' : '',
                    node.categorySlug === 'transformer' ? 'border-dashed' : 'border-transparent',
                    !activeParties.has(col.id) ? 'opacity-20 pointer-events-none' : '',
                  ]"
                  @mouseenter="hoverNode(node.id)"
                  @mouseleave="unhoverNode()"
                  @click="goToExplorer(node.name)"
                  :title="node.name + ' (' + node.year + ', ' + node.parties + ')' + (node.malicious ? ' · malicious security model' : '')"
                >
                  <span x-text="node.name"></span>
                  <template x-if="node.malicious">
                    <i class="ph ph-shield-check text-[9px] opacity-70"></i>
                  </template>
                  <template x-if="node.categorySlug === 'transformer'">
                    <i class="ph ph-sparkle text-[9px] opacity-70"></i>
                  </template>
                </button>
              </template>
            </div>
          </template>
        </div>
      </template>
    </div>

    <!-- Category legend -->
    <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500">
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-3 h-3 rounded-full bg-blue-500/40 border border-blue-400"></span>
        2-party (2PC)
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-3 h-3 rounded-full bg-teal-500/40 border border-teal-400"></span>
        3-party (3PC)
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-3 h-3 rounded-full bg-purple-500/40 border border-purple-400"></span>
        4-party (4PC)
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-3 h-3 rounded-full bg-slate-500/40 border border-slate-400"></span>
        n-party (nPC)
      </span>
      <span class="flex items-center gap-1.5 ml-4">
        <span class="inline-block px-2 py-0.5 rounded-full border border-dashed border-sky-400 text-sky-300 text-[10px]">
          <i class="ph ph-sparkle"></i> LLM
        </span>
        transformer-focused
      </span>
      <span class="flex items-center gap-1.5">
        <i class="ph ph-shield-check text-slate-400"></i>
        malicious security model
      </span>
    </div>

    <!-- Tooltip -->
    <div
      x-show="hoveredNode && tooltip.visible"
      x-cloak
      class="fixed z-50 pointer-events-none bg-navy-800 border border-slate-600 rounded-lg px-3 py-2 shadow-xl text-xs"
      :style="`left: ${tooltip.x}px; top: ${tooltip.y}px; transform: translate(-50%, -110%);`"
    >
      <template x-if="tooltipNode">
        <div>
          <div class="font-bold text-white mb-0.5" x-text="tooltipNode.name"></div>
          <div class="text-slate-400 flex items-center gap-2">
            <span x-text="tooltipNode.year"></span>
            <span class="text-slate-600">·</span>
            <span x-text="tooltipNode.parties"></span>
            <span class="text-slate-600">·</span>
            <span x-text="tooltipNode.category"></span>
          </div>
          <template x-if="edgeSummary.length">
            <div class="mt-1.5 text-slate-400 border-t border-slate-700 pt-1.5" x-text="edgeSummary"></div>
          </template>
        </div>
      </template>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script is:inline>
document.addEventListener('alpine:init', () => {
  Alpine.data('genealogy', () => ({
    nodes: (window.__GENEALOGY__ || {}).nodes || [],
    edges: (window.__GENEALOGY__ || {}).edges || [],
    base: window.__BASE__ || '',
    showEdges: true,
    hoveredNode: null,
    computedEdges: [],
    tooltip: { x: 0, y: 0, visible: false },

    get years() {
      if (!this.nodes.length) return []
      const allYears = this.nodes.map(n => n.year)
      const min = Math.min(...allYears)
      const max = Math.max(...allYears)
      return Array.from({ length: max - min + 1 }, (_, i) => min + i)
    },

    columns: [
      { id: '2PC', label: '2-Party (2PC)', headerClass: 'text-blue-400',  pillClass: 'bg-blue-900/40 text-blue-300 border-blue-700/50 hover:bg-blue-800/60' },
      { id: '3PC', label: '3-Party (3PC)', headerClass: 'text-teal-400',  pillClass: 'bg-teal-900/40 text-teal-300 border-teal-700/50 hover:bg-teal-800/60' },
      { id: '4PC', label: '4-Party (4PC)', headerClass: 'text-purple-400',pillClass: 'bg-purple-900/40 text-purple-300 border-purple-700/50 hover:bg-purple-800/60' },
      { id: 'nPC', label: 'n-Party (nPC)', headerClass: 'text-slate-400', pillClass: 'bg-slate-700/40 text-slate-300 border-slate-600/50 hover:bg-slate-700/60' },
    ],

    partyTypes: [
      { id: '2PC', label: '2PC', activeBg: 'bg-blue-600' },
      { id: '3PC', label: '3PC', activeBg: 'bg-teal-600' },
      { id: '4PC', label: '4PC', activeBg: 'bg-purple-600' },
      { id: 'nPC', label: 'nPC', activeBg: 'bg-slate-600' },
    ],

    activeParties: new Set(['2PC','3PC','4PC','nPC']),

    toggleParty(id) {
      if (this.activeParties.has(id)) {
        this.activeParties.delete(id)
      } else {
        this.activeParties.add(id)
      }
      this.activeParties = new Set(this.activeParties)
      this.$nextTick(() => this.recalcEdges())
    },

    nodesInCell(year, party) {
      return this.nodes.filter(n => n.year === year && n.partyBuckets.includes(party))
    },

    hasNodesInYear(year) {
      return this.nodes.some(n => n.year === year)
    },

    get tooltipNode() {
      if (!this.hoveredNode) return null
      return this.nodes.find(n => n.id === this.hoveredNode) || null
    },

    get edgeSummary() {
      if (!this.hoveredNode) return ''
      const outgoing = this.edges.filter(e => e.from === this.hoveredNode).map(e => {
        const t = this.nodes.find(n => n.id === e.to)
        return t ? t.name : e.to
      })
      const incoming = this.edges.filter(e => e.to === this.hoveredNode).map(e => {
        const f = this.nodes.find(n => n.id === e.from)
        return f ? f.name : e.from
      })
      const parts = []
      if (incoming.length) parts.push(`From: ${incoming.join(', ')}`)
      if (outgoing.length) parts.push(`To: ${outgoing.join(', ')}`)
      return parts.join(' · ')
    },

    connectedTo(nodeId) {
      if (!this.hoveredNode) return false
      return this.edges.some(e =>
        (e.from === this.hoveredNode && e.to === nodeId) ||
        (e.to === this.hoveredNode && e.from === nodeId)
      )
    },

    hoverNode(id) {
      this.hoveredNode = id
      const el = document.getElementById('node-' + id)
      if (el) {
        const r = el.getBoundingClientRect()
        this.tooltip.x = r.left + r.width / 2
        this.tooltip.y = r.top + window.scrollY
        this.tooltip.visible = true
      }
      this.recalcEdges()
    },

    unhoverNode() {
      this.hoveredNode = null
      this.tooltip.visible = false
      this.recalcEdges()
    },

    nodeCenter(id) {
      const el = document.getElementById('node-' + id)
      if (!el) return null
      const svg = document.getElementById('genealogy-svg')
      if (!svg) return null
      const er = el.getBoundingClientRect()
      const sr = svg.getBoundingClientRect()
      // Account for scroll offset of the overflow-x-auto container
      const scroller = svg.closest('.overflow-x-auto')
      const scrollX = scroller ? scroller.scrollLeft : 0
      const scrollY = scroller ? scroller.scrollTop : 0
      return {
        x: er.left + er.width / 2 - sr.left + scrollX,
        y: er.top + er.height / 2 - sr.top + scrollY,
      }
    },

    recalcEdges() {
      const NS = 'http://www.w3.org/2000/svg'
      const g = document.getElementById('genealogy-edges')
      if (!g) return
      // Clear previous paths
      while (g.firstChild) g.removeChild(g.firstChild)

      let drawn = 0, missing = 0
      for (const edge of this.edges) {
        const fromNode = this.nodes.find(n => n.id === edge.from)
        const toNode = this.nodes.find(n => n.id === edge.to)
        if (!fromNode || !toNode) continue
        if (!fromNode.partyBuckets.some(b => this.activeParties.has(b)) || !toNode.partyBuckets.some(b => this.activeParties.has(b))) continue

        const from = this.nodeCenter(edge.from)
        const to   = this.nodeCenter(edge.to)
        if (!from || !to) { missing++; continue }

        const dy = to.y - from.y
        const dx = to.x - from.x
        const cx1 = from.x + dx * 0.2
        const cy1 = from.y + dy * 0.6
        const cx2 = to.x - dx * 0.2
        const cy2 = to.y - dy * 0.4

        const highlighted = this.hoveredNode
          ? (edge.from === this.hoveredNode || edge.to === this.hoveredNode)
          : false

        const path = document.createElementNS(NS, 'path')
        path.setAttribute('d', `M ${from.x} ${from.y} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${to.x} ${to.y}`)
        path.setAttribute('stroke', highlighted ? '#38bdf8' : '#64748b')
        path.setAttribute('stroke-width', highlighted ? '2' : '1.5')
        path.setAttribute('stroke-dasharray', edge.type === 'inspires' ? '5,3' : 'none')
        path.setAttribute('opacity', highlighted ? '1' : (this.hoveredNode ? '0.1' : '0.6'))
        path.setAttribute('fill', 'none')
        const markerSuffix = highlighted ? '-hi' : ''
        path.setAttribute('marker-end', `url(#arrow-${edge.type}${markerSuffix})`)
        path.style.transition = 'opacity 0.2s, stroke 0.2s'
        g.appendChild(path)
        drawn++
      }
      this.computedEdges = [] // kept for compat; actual rendering is imperative
    },

    goToExplorer(name) {
      // URL encode and navigate to explorer filtered by protocol name
      const url = this.base + '/explorer?q=' + encodeURIComponent(name)
      window.location.href = url
    },

    fitSvg() {
      const svg = document.getElementById('genealogy-svg')
      if (!svg) return
      const container = svg.closest('.overflow-x-auto') || svg.parentElement
      if (container) {
        svg.setAttribute('width', container.scrollWidth)
        svg.setAttribute('height', container.scrollHeight)
        svg.style.width = container.scrollWidth + 'px'
        svg.style.height = container.scrollHeight + 'px'
      }
    },

    init() {
      // Double-RAF after $nextTick ensures x-for nodes are painted before measuring
      const tryDraw = (attempts) => {
        this.fitSvg()
        this.recalcEdges()
        if (attempts > 0 && this.computedEdges.length === 0) {
          requestAnimationFrame(() => requestAnimationFrame(() => tryDraw(attempts - 1)))
        }
      }
      this.$nextTick(() => requestAnimationFrame(() => requestAnimationFrame(() => tryDraw(8))))

      window.addEventListener('resize', () => {
        clearTimeout(this._resizeTimer)
        this._resizeTimer = setTimeout(() => { this.fitSvg(); this.recalcEdges() }, 100)
      })
      const scroller = document.getElementById('genealogy-svg')?.closest('.overflow-x-auto')
      if (scroller) {
        scroller.addEventListener('scroll', () => {
          clearTimeout(this._scrollTimer)
          this._scrollTimer = setTimeout(() => this.recalcEdges(), 30)
        })
      }
    },
  }))
})
</script>
