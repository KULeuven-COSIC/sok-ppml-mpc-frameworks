---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { readFileSync } from 'fs'
import { join } from 'path'

// BibTeX wraps words in {braces} to protect their capitalization at compile time
// (e.g. "{ABY} - {A} Framework..."); those braces carry no meaning once rendered
// as plain text, so strip them.
const stripBraces = (s) => s.replace(/[{}]/g, '')

function parseRefs(filePath) {
  const content = readFileSync(join(process.cwd(), filePath), 'utf-8')
  const refs = []
  // Each reference starts with: N. <a id="ANCHOR"></a>content
  const lineRe = /^(\d+)\.\s*<a id="([^"]+)"><\/a>(.*)/
  for (const line of content.split('\n')) {
    const m = line.match(lineRe)
    if (!m) continue
    const [, num, anchor, rest] = m
    // Most entries use curly quotes (" ") but a handful of newer ones use straight
    // quotes ("); authors end at whichever opening quote character appears first.
    const straightIdx = rest.indexOf('"')
    const curlyIdx = rest.indexOf('“')
    const quoteIdx = [straightIdx, curlyIdx].filter(i => i > 0).sort((a, b) => a - b)[0] ?? -1
    // .trim() before stripping the trailing "." -- the raw text has a space before
    // the opening quote ("...Rabin. “How..."), so a trailing-period regex run
    // before trimming never matched (the last character was a space, not a period),
    // leaving every entry's authors ending in a stray period that then combined with
    // the template's own separator into "Rabin..".
    const authors = stripBraces(quoteIdx > 0 ? rest.slice(0, quoteIdx).trim().replace(/\.$/, '') : rest.trim())
    // title: between the first pair of quotes, curly or straight. Titles in the source
    // already end with their own "." inside the closing quote, so strip it here too --
    // the template appends its own "." unconditionally when rendering.
    const titleM = rest.match(/“([^”]+)”/) || rest.match(/"([^"]+)"/)
    const title = titleM ? stripBraces(titleM[1].replace(/\.$/, '')) : ''
    // venue: between * *
    const venueM = rest.match(/\*([^*]+)\*/)
    const venue = venueM ? stripBraces(venueM[1]) : ''
    // year: last 4-digit number before any URL
    const yearM = rest.match(/\b(19|20)\d{2}\b/)
    const year = yearM ? yearM[0] : ''
    // DOI url
    const doiM = rest.match(/DOI:\s*\[([^\]]+)\]\(([^)]+)\)/)
    const urlM = rest.match(/URL:\s*\[([^\]]+)\]\(([^)]+)\)/)
    const paperUrl = doiM ? doiM[2] : urlM ? urlM[2] : null
    const paperLabel = doiM ? doiM[1] : urlM ? 'Link' : null
    refs.push({ num: parseInt(num), anchor, authors, title, venue, year, paperUrl, paperLabel })
  }
  return refs
}

const refs = parseRefs('Bibliography/references.md')
const refsJson = JSON.stringify(refs)
const base = import.meta.env.BASE_URL
---

<Layout title="Bibliography">
  <Navbar slot="navbar" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="section-heading">Bibliography</h1>
      <p class="section-subheading">{refs.length} references — click any framework citation to jump here</p>
    </div>

    <script define:vars={{ refsJson }}>
      window.__REFS__ = JSON.parse(refsJson)
    </script>

    <div x-data="{
      refs: window.__REFS__,
      query: '',
      get filtered() {
        const q = this.query.toLowerCase().trim()
        if (!q) return this.refs
        return this.refs.filter(r =>
          r.authors.toLowerCase().includes(q) ||
          r.title.toLowerCase().includes(q) ||
          r.venue.toLowerCase().includes(q) ||
          String(r.year).includes(q) ||
          String(r.num).includes(q)
        )
      },
      scrollToHash() {
        if (!location.hash) return
        const id = decodeURIComponent(location.hash.slice(1))
        // Double-RAF: the browser's own hash-scroll already ran (and found nothing,
        // since these ids only exist once Alpine's x-for paints them), so wait for
        // the next two paints before looking the element up ourselves.
        requestAnimationFrame(() => requestAnimationFrame(() => {
          const el = document.getElementById(id)
          if (!el) return
          // No explicit `behavior` - <html> already has Tailwind's scroll-smooth
          // class, and forcing behavior:'smooth' here didn't reliably animate.
          el.scrollIntoView({ block: 'center' })
          // Direct DOM manipulation rather than a reactive :class binding, since
          // x-for elements can be numerous and this only needs to touch one node.
          el.classList.add('border-brand-500', 'ring-2', 'ring-brand-500/50')
          setTimeout(() => {
            el.classList.remove('border-brand-500', 'ring-2', 'ring-brand-500/50')
          }, 2500)
        }))
      }
    }" x-init="$nextTick(() => scrollToHash())" x-cloak>

      <div class="mb-6 flex items-center gap-3">
        <div class="relative flex-1 max-w-lg">
          <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
          <input
            x-model="query"
            type="text"
            placeholder="Search by author, title, venue, or year…"
            class="input-field pl-9 w-full"
          />
        </div>
        <span class="text-xs text-slate-500 whitespace-nowrap" x-text="filtered.length + ' references'"></span>
      </div>

      <ol class="space-y-4">
        <template x-for="r in filtered" :key="r.num">
          <li
            :id="r.anchor"
            class="group flex gap-4 p-4 rounded-xl bg-navy-800/50 border border-slate-700/40 hover:border-slate-600 transition-colors scroll-mt-24"
          >
            <span class="flex-shrink-0 w-10 text-right font-mono text-slate-500 text-sm pt-0.5" x-text="'[' + r.num + ']'"></span>
            <div class="min-w-0">
              <div class="text-slate-300 text-sm leading-relaxed">
                <span class="text-slate-400" x-text="r.authors + (r.authors ? '. ' : '')"></span>
                <span class="text-white font-medium" x-text="r.title ? '“' + r.title + '.”' : ''"></span>
                <template x-if="r.venue">
                  <em class="text-slate-400 not-italic" x-text="' ' + r.venue + (r.year ? ' ' + r.year : '') + '.'"></em>
                </template>
                <template x-if="r.paperUrl">
                  <a
                    :href="r.paperUrl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-2 inline-flex items-center gap-1 text-brand-400 hover:text-brand-300 text-xs transition-colors"
                  >
                    <i class="ph ph-arrow-square-out"></i>
                    <span x-text="r.paperLabel || 'Link'"></span>
                  </a>
                </template>
              </div>
              <div class="mt-1 flex items-center gap-2">
                <span class="text-xs text-slate-600 font-mono" x-text="r.anchor"></span>
                <button
                  x-on:click="navigator.clipboard.writeText(window.location.origin + window.location.pathname + '#' + r.anchor)"
                  class="opacity-0 group-hover:opacity-100 transition-opacity text-slate-600 hover:text-slate-400"
                  title="Copy link"
                >
                  <i class="ph ph-link text-xs"></i>
                </button>
              </div>
            </div>
          </li>
        </template>
        <template x-if="filtered.length === 0">
          <li class="text-center py-12 text-slate-500">No references match your search.</li>
        </template>
      </ol>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
