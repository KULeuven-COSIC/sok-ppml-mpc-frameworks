---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { readFileSync } from 'fs'
import { join } from 'path'
import { cleanName } from '../scripts/parseTable.mjs'

const base = import.meta.env.BASE_URL

function parseMdTable(filePath) {
  try {
    const content = readFileSync(join(process.cwd(), filePath), 'utf-8')
    const lines = content.split('\n')
    const tableLines = []
    let inTable = false
    for (const line of lines) {
      if (line.trim().startsWith('|')) { inTable = true; tableLines.push(line.trim()) }
      else if (inTable && line.trim() === '') break
    }
    if (tableLines.length < 3) return []
    const headers = tableLines[0].split('|').slice(1, -1).map(h => h.trim())
    return tableLines.slice(2).map(line => {
      const cells = line.split('|').slice(1, -1).map(c => c.trim())
      const obj = {}
      headers.forEach((h, i) => { obj[h] = cells[i] || '' })
      return obj
    })
  } catch { return [] }
}

function cleanRef(cell) {
  // Remove bold markers, then strip the citation-ref link entirely (its bracketed
  // content is just the bibliography reference number, not part of the display text).
  return cleanName((cell || '').replace(/\*\*/g, ''))
}

function norm(s) {
  const t = (s || '').replace(/\*\*/g, '').trim()
  if (t === '✓') return true
  if (t === '✗') return false
  return t
}

const rawRows = parseMdTable('Tables/Related-work/related-work-comparison.md')

const boolCols = ['MPC', 'FSS', 'FHE', 'TEE', 'Hybrid', 'C/S', 'TTP', 'Outsourcing', 'Inference', 'Training']

const rows = rawRows.map((r, idx) => {
  const ref = cleanRef(r['Reference'] || '')
  const isOurs = ref === 'This Work' || (r['Reference'] || '').includes('**This Work**') || (r['Reference'] || '').includes('This Work')
  const obj = {
    idx: idx + 1,
    reference: ref,
    year: (r['Year'] || '').replace(/\*\*/g, '').trim(),
    sokSurvey: (r['SoK/Survey'] || '').replace(/\*\*/g, '').trim(),
    addedValue: (r['Added value'] || '').replace(/\*\*/g, '').trim(),
    isOurs,
  }
  for (const col of boolCols) {
    obj[col] = norm(r[col])
  }
  return obj
})

const relatedJson = JSON.stringify(rows)
---

<Layout title="Related Work">
  <Navbar slot="navbar" />

  <script define:vars={{ relatedJson }}>
    window.__RELATED__ = JSON.parse(relatedJson)
  </script>

  <script is:inline>
    document.addEventListener('alpine:init', () => {
      Alpine.data('relatedWorkPage', () => ({
        rows: window.__RELATED__,
        search: '',
        get filtered() {
          const q = this.search.toLowerCase().trim()
          if (!q) return this.rows
          return this.rows.filter(r =>
            r.reference.toLowerCase().includes(q) ||
            r.addedValue.toLowerCase().includes(q) ||
            r.year.includes(q) ||
            r.sokSurvey.toLowerCase().includes(q)
          )
        },
        boolIcon(val) {
          return val === true ? '✓' : val === false ? '✗' : val
        },
        boolClass(val) {
          if (val === true) return 'text-emerald-400'
          if (val === false) return 'text-red-400 opacity-50'
          return 'text-slate-400 text-xs'
        },
        boolIconClass(val) {
          if (val === true) return 'ph ph-check text-emerald-400'
          if (val === false) return 'ph ph-x text-red-400 opacity-50'
          return ''
        },
      }))
    })
  </script>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="section-heading">Related Work</h1>
      <p class="section-subheading !mb-4">
        Comparison of our SoK to related surveys and SoKs in the domain of Privacy-Preserving Machine Learning.
      </p>
      <div class="flex flex-wrap gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border bg-teal-900/40 text-teal-300 border-teal-800">{rows.filter(r => r.sokSurvey === 'SoK').length} SoKs</span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border bg-blue-900/40 text-blue-300 border-blue-800">{rows.filter(r => r.sokSurvey === 'Survey').length} Surveys</span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border bg-brand-900/40 text-brand-300 border-brand-800">{rows.length} total works</span>
      </div>
    </div>

    <!-- Alpine interactive section -->
    <div x-data="relatedWorkPage()" x-cloak>
      <!-- Search bar -->
      <div class="bg-navy-800 border border-slate-700/50 rounded-xl p-4 mb-4">
        <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
          <div class="relative w-full sm:max-w-sm">
            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
            <input
              type="text"
              x-model="search"
              placeholder="Search by reference, added value, year..."
              class="input-field pl-9 w-full"
            />
          </div>
          <span class="text-slate-500 text-xs whitespace-nowrap" x-text="`Showing ${filtered.length} of ${rows.length} works`"></span>
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto rounded-xl border border-slate-700/50">
        <table class="data-table">
          <thead>
            <tr>
              <th class="text-center w-8">#</th>
              <th class="min-w-[160px]">Reference</th>
              <th class="text-center">Year</th>
              <th class="text-center">Type</th>
              <th class="text-center">MPC</th>
              <th class="text-center">FSS</th>
              <th class="text-center">FHE</th>
              <th class="text-center">TEE</th>
              <th class="text-center">Hybrid</th>
              <th class="text-center">C/S</th>
              <th class="text-center">TTP</th>
              <th class="text-center">Outsrc</th>
              <th class="text-center">Infer</th>
              <th class="text-center">Train</th>
              <th class="min-w-[200px]">Added Value</th>
            </tr>
          </thead>
          <tbody>
            <template x-for="r in filtered" :key="r.idx">
              <tr
                :class="r.isOurs ? 'bg-brand-900/20 border-l-2 border-brand-400' : ''"
              >
                <td class="text-center text-slate-500 text-xs" x-text="r.idx"></td>
                <td>
                  <span
                    :class="r.isOurs ? 'font-bold text-brand-300' : 'font-medium text-slate-200'"
                    x-text="r.reference"
                  ></span>
                </td>
                <td class="text-center text-slate-400 text-xs" x-text="r.year"></td>
                <td class="text-center">
                  <span
                    :class="{
                      'bg-teal-900/40 text-teal-300 border-teal-800': r.sokSurvey === 'SoK',
                      'bg-blue-900/40 text-blue-300 border-blue-800': r.sokSurvey === 'Survey',
                      'bg-brand-900/40 text-brand-300 border-brand-700': r.isOurs && r.sokSurvey === 'SoK',
                    }"
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border"
                    x-text="r.sokSurvey"
                  ></span>
                </td>
                <!-- Boolean columns -->
                <template x-for="col in ['MPC','FSS','FHE','TEE','Hybrid','C/S','TTP','Outsourcing','Inference','Training']" :key="col">
                  <td class="text-center">
                    <i :class="boolIconClass(r[col])" class="text-base leading-none"></i>
                    <template x-if="r[col] !== true && r[col] !== false">
                      <span class="text-slate-400 text-xs" x-text="r[col]"></span>
                    </template>
                  </td>
                </template>
                <td>
                  <span
                    :class="r.isOurs ? 'text-brand-200 font-medium text-xs' : 'text-slate-400 text-xs'"
                    x-text="r.addedValue"
                  ></span>
                </td>
              </tr>
            </template>
            <template x-if="filtered.length === 0">
              <tr>
                <td colspan="15" class="text-center py-8 text-slate-500">No works match the search query.</td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Legend -->
      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-slate-500">
        <span class="font-medium text-slate-400">Legend:</span>
        <span><i class="ph ph-check text-emerald-400"></i> Covered</span>
        <span><i class="ph ph-x text-red-400 opacity-50"></i> Not covered</span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-3 h-3 rounded-sm border-l-2 border-brand-400 bg-brand-900/20"></span>
          This Work (our SoK)
        </span>
        <span class="ml-auto text-slate-600">C/S = Client/Server · TTP = Trusted Third Party · Outsrc = Outsourcing</span>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
