---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { readFileSync } from 'fs'
import { join } from 'path'

const base = import.meta.env.BASE_URL

function parseSchemes(content) {
  const start = content.indexOf('#### Secret-Sharing Schemes')
  const end = content.indexOf('**Naive conversion**')
  const section = content.slice(start, end)
  const schemes = []
  const bulletRe = /-\s*\*\*(.+?)\s*\(`(.+?)`\)\*\*:\s*(.+)/g
  let m
  while ((m = bulletRe.exec(section))) {
    schemes.push({ name: m[1].trim(), tag: m[2].trim(), description: m[3].trim() })
  }
  return schemes
}

function parseNaive(content) {
  const m = content.match(/\*\*Naive conversion\*\*:\s*([^\n]+)/)
  return m ? m[1].trim() : ''
}

function parseInsight(content) {
  const idx = content.indexOf('#### Insight: Share Conversions')
  if (idx === -1) return ''
  const after = content.slice(idx)
  const m = after.match(/#### Insight: Share Conversions\s*\n\n([^\n]+(?:\n[^\n]+)*)/)
  if (!m) return ''
  return m[1].replace(/\n/g, ' ').replace(/`/g, '').replace(/\*(.+?)\*/g, '$1').trim()
}

function splitTitle(title) {
  const m = title.match(/^(.+?)\s*\(([^)]+)\)$/)
  if (!m) return { label: title, subtitle: '' }
  const [, main, paren] = m
  if (/^\d(PC)?$/.test(paren) || /^\dPC$/.test(paren)) {
    return { label: paren, subtitle: '' }
  }
  return { label: main, subtitle: paren }
}

function parseTableBlocks(section) {
  const blocks = section.split(/\n##### /).slice(1)
  return blocks.map(block => {
    const lines = block.split('\n')
    const title = lines[0].trim()
    const { label, subtitle } = splitTitle(title)
    const stripCode = s => s.replace(/`/g, '')
    const tableLines = lines.filter(l => l.trim().startsWith('|'))
    const headers = tableLines[0].split('|').slice(1, -1).map(h => stripCode(h.trim()))
    const rows = tableLines.slice(2).map(line => {
      const cells = line.split('|').slice(1, -1).map(c => stripCode(c.trim()))
      return { label: cells[0], costs: cells.slice(1) }
    })
    return { key: label, label, subtitle, headers: headers.slice(1), rows }
  })
}

function parseConversionTables(content) {
  const sameStart = content.indexOf('#### Same-Party-Set Conversion Costs')
  const crossStart = content.indexOf('#### Cross-Party-Set Conversion Costs')
  const insightStart = content.indexOf('#### Insight: Share Conversions')
  const sameSection = content.slice(sameStart, crossStart)
  const crossSection = content.slice(crossStart, insightStart)
  return {
    sameSet: parseTableBlocks(sameSection),
    crossSet: parseTableBlocks(crossSection),
  }
}

let schemes = []
let naive = ''
let insight = ''
let sameSet = []
let crossSet = []
try {
  const raw = readFileSync(join(process.cwd(), 'Tables/MPC-Puzzle/mpc-puzzle.md'), 'utf-8')
  schemes = parseSchemes(raw)
  naive = parseNaive(raw)
  insight = parseInsight(raw)
  const parsed = parseConversionTables(raw)
  sameSet = parsed.sameSet
  crossSet = parsed.crossSet
} catch (e) {}

const dataJson = JSON.stringify({ sameSet, crossSet })
const baseUrl = base
---

<Layout title="MPC Puzzle" description="A unification of 2-, 3-, and 4-party secret-sharing schemes, and the communication cost of converting between them.">
  <Navbar slot="navbar" />

  <script define:vars={{ dataJson, baseUrl }}>
    window.__MPC_PUZZLE__ = JSON.parse(dataJson)
    window.__BASE__ = baseUrl
  </script>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Header -->
    <div class="mb-12 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-medium mb-6">
        <i class="ph ph-puzzle-piece"></i>
        Key Contribution
      </div>
      <h1 class="section-heading text-4xl">The MPC Puzzle</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-lg leading-relaxed">
        A unification of 2-, 3-, and 4-party secret-sharing schemes — showing how seemingly
        separate frameworks share a common algebraic foundation and can convert between each other.
      </p>
    </div>

    <!-- Main Puzzle Diagram -->
    <div class="mb-16">
      <div class="relative">
        <!-- Triangle layout with connecting arrows -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 relative">

          <!-- 2PC Node -->
          <div class="bg-blue-950/40 border-2 border-blue-600/50 rounded-2xl p-6 relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400 font-bold text-lg">2</div>
              <div>
                <h3 class="text-white font-bold text-lg">2-Party (2PC)</h3>
                <div class="text-blue-400 text-xs font-medium">Dishonest Majority</div>
              </div>
            </div>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between items-center py-2 border-b border-blue-900/50">
                <span class="text-slate-400">Algebraic Structure</span>
                <span class="text-slate-200 font-mono text-xs" set:html="$\\mathbb{Z}_{2^{\\ell}}$, $\\mathbb{Z}_2$, $\\mathbb{F}_p$" />
              </div>
              <div class="flex justify-between items-center py-2 border-b border-blue-900/50">
                <span class="text-slate-400">Security</span>
                <span class="text-slate-200">SH / Active-Covert</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-blue-900/50">
                <span class="text-slate-400">Techniques</span>
                <span class="text-slate-200">OT, HE, GC, FSS, SS</span>
              </div>
              <div class="flex justify-between items-center py-2">
                <span class="text-slate-400">Representative</span>
                <span class="text-slate-200">SecureML, CryptFlow2, Llama</span>
              </div>
            </div>
            <div class="mt-4 p-3 bg-blue-950/60 rounded-lg">
              <p class="text-blue-300 text-xs leading-relaxed">
                Largest class. Typically client-server or outsourcing setting. Relies on OT/HE for garbling and secret sharing between two mutually distrusting parties.
              </p>
            </div>
          </div>

          <!-- 3PC Node -->
          <div class="bg-teal-950/40 border-2 border-teal-600/50 rounded-2xl p-6 relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-teal-600/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-lg">3</div>
              <div>
                <h3 class="text-white font-bold text-lg">3-Party (3PC)</h3>
                <div class="text-teal-400 text-xs font-medium">Honest Majority</div>
              </div>
            </div>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between items-center py-2 border-b border-teal-900/50">
                <span class="text-slate-400">Algebraic Structure</span>
                <span class="text-slate-200 font-mono text-xs" set:html="$\\mathbb{Z}_{2^{\\ell}}$, $\\mathbb{F}_p$" />
              </div>
              <div class="flex justify-between items-center py-2 border-b border-teal-900/50">
                <span class="text-slate-400">Security</span>
                <span class="text-slate-200">SH / A / F / R</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-teal-900/50">
                <span class="text-slate-400">Techniques</span>
                <span class="text-slate-200">Replicated SS, OT</span>
              </div>
              <div class="flex justify-between items-center py-2">
                <span class="text-slate-400">Representative</span>
                <span class="text-slate-200">ABY3, Falcon, SecureNN</span>
              </div>
            </div>
            <div class="mt-4 p-3 bg-teal-950/60 rounded-lg">
              <p class="text-teal-300 text-xs leading-relaxed">
                Efficient semi-honest protocols with strong honest majority assumption. Replicated secret sharing enables cheap multiplications with low communication rounds.
              </p>
            </div>
          </div>

          <!-- 4PC Node -->
          <div class="bg-purple-950/40 border-2 border-purple-600/50 rounded-2xl p-6 relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-purple-600/20 border border-purple-500/40 flex items-center justify-center text-purple-400 font-bold text-lg">4</div>
              <div>
                <h3 class="text-white font-bold text-lg">4-Party (4PC)</h3>
                <div class="text-purple-400 text-xs font-medium">Super Honest Majority</div>
              </div>
            </div>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between items-center py-2 border-b border-purple-900/50">
                <span class="text-slate-400">Algebraic Structure</span>
                <span class="text-slate-200 font-mono text-xs" set:html="$\\mathbb{Z}_{2^{\\ell}}$, $\\mathbb{Z}_2$" />
              </div>
              <div class="flex justify-between items-center py-2 border-b border-purple-900/50">
                <span class="text-slate-400">Security</span>
                <span class="text-slate-200">A/R / F/R</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-purple-900/50">
                <span class="text-slate-400">Techniques</span>
                <span class="text-slate-200">Replicated SS</span>
              </div>
              <div class="flex justify-between items-center py-2">
                <span class="text-slate-400">Representative</span>
                <span class="text-slate-200">FLASH, Trident, Tetrad</span>
              </div>
            </div>
            <div class="mt-4 p-3 bg-purple-950/60 rounded-lg">
              <p class="text-purple-300 text-xs leading-relaxed">
                Strongest security guarantees — tolerates up to one active corruption with guaranteed output delivery (robustness). Higher communication but maximum resilience.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Secret Sharing Schemes -->
    <div class="mb-16">
      <h2 class="section-heading">Secret-Sharing Schemes</h2>
      <p class="section-subheading">The three algebraic building blocks unified across every party configuration</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="schemes-grid">
        {schemes.map(s => (
          <div class="border border-slate-700/50 bg-navy-800/40 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="text-white font-semibold">{s.name}</h3>
              <span class="text-xs px-2 py-0.5 rounded-full font-mono font-medium bg-slate-800 text-slate-300">{s.tag}</span>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed" set:html={s.description} />
          </div>
        ))}
      </div>
      <div class="mt-5 flex items-start gap-2 text-xs text-slate-500 bg-navy-800/30 border border-slate-700/40 rounded-lg p-3">
        <i class="ph ph-info mt-0.5 flex-shrink-0"></i>
        <span set:html={naive} />
      </div>
    </div>

    <!-- Conversion Costs -->
    <div class="mb-16" id="conversion-costs" x-data="mpcPuzzle()" x-cloak>
      <h2 class="section-heading flex items-center gap-2">
        <i class="ph ph-arrows-left-right text-purple-400"></i>
        Conversion Costs
      </h2>
      <p class="section-subheading">Communication cost per secret-shared element, from the paper's Appendix E</p>

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-1">Same party set</span>
        <template x-for="t in sameSet" :key="t.key">
          <button
            @click="active = t.key"
            :class="active === t.key ? 'bg-brand-500/15 border-brand-500/50 text-brand-400' : 'bg-navy-800 border-slate-700/50 text-slate-400 hover:border-slate-500 hover:text-slate-200'"
            class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition-colors"
            x-text="t.label"
          ></button>
        </template>
      </div>
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-1">Cross party set</span>
        <template x-for="t in crossSet" :key="t.key">
          <button
            @click="active = t.key"
            :class="active === t.key ? 'bg-brand-500/15 border-brand-500/50 text-brand-400' : 'bg-navy-800 border-slate-700/50 text-slate-400 hover:border-slate-500 hover:text-slate-200'"
            class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition-colors"
            x-text="t.label"
          ></button>
        </template>
      </div>

      <div class="bg-slate-900/60 border border-slate-700/50 rounded-2xl overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-800/60 bg-slate-800/30" x-show="currentTable?.subtitle">
          <p class="text-xs text-slate-500" x-text="currentTable?.subtitle"></p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-700/60 bg-slate-800/50">
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">From \ To</th>
                <template x-for="h in currentTable?.headers || []" :key="h">
                  <th class="px-4 py-3 text-center text-xs font-semibold text-slate-400 uppercase tracking-wider" x-text="h"></th>
                </template>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              <template x-for="row in currentTable?.rows || []" :key="row.label">
                <tr class="hover:bg-slate-800/30 transition-colors">
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-mono font-medium bg-slate-800 text-slate-300 border border-slate-600/30" x-text="row.label"></span>
                  </td>
                  <template x-for="cost in row.costs" :key="cost">
                    <td class="px-4 py-3 text-center text-slate-300 text-xs" x-html="renderLatex(cost)"></td>
                  </template>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <div class="px-4 py-3 border-t border-slate-800/60 bg-slate-900/40">
          <p class="text-xs text-slate-500">All costs are in bits per element. <span class="font-mono" x-html="renderLatex(ellSymbol)"></span> = ring/field bitwidth. A range (e.g. <span class="font-mono" x-html="renderLatex(rangeExample)"></span>) gives the communication-optimized protocol first, the direct one-round protocol second. Source: Appendix E.</p>
        </div>
      </div>
    </div>

    <!-- Key Insight -->
    <div class="mb-12">
      <div class="bg-gradient-to-r from-purple-950/40 to-blue-950/40 border border-purple-700/30 rounded-2xl p-8 text-center">
        <i class="ph ph-lightbulb text-4xl text-yellow-400 mb-4 block"></i>
        <h2 class="text-white font-bold text-xl mb-3">Insight: Share Conversions</h2>
        <p class="text-slate-300 max-w-2xl mx-auto leading-relaxed">{insight}</p>
        <a href="https://eprint.iacr.org/2025/1679" target="_blank" rel="noopener noreferrer" class="btn-primary mt-6 inline-flex">
          <i class="ph ph-file-pdf"></i>
          Full Details in the Paper
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script is:inline>
    (function() {
      function renderStaticMath() {
        if (typeof renderMathInElement === 'undefined') return;
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$', right: '$', display: false },
            { left: '$$', right: '$$', display: true }
          ],
          throwOnError: false
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderStaticMath);
      } else {
        renderStaticMath();
      }
    })();

    document.addEventListener('alpine:init', () => {
      Alpine.data('mpcPuzzle', () => ({
        sameSet: (window.__MPC_PUZZLE__ || {}).sameSet || [],
        crossSet: (window.__MPC_PUZZLE__ || {}).crossSet || [],
        active: '2PC',
        ellSymbol: '$\\ell$',
        rangeExample: '$4$–$5\\ell$',

        get currentTable() {
          return this.sameSet.find(t => t.key === this.active) || this.crossSet.find(t => t.key === this.active) || null
        },

        renderLatex(str) {
          if (!str || str === '---' || str === '') {
            return '<span class="text-slate-600">—</span>'
          }
          if (typeof window.katex === 'undefined') return str
          try {
            const parts = str.split('$')
            if (parts.length < 3) return str
            let out = parts[0]
            for (let i = 1; i + 1 < parts.length; i += 2) {
              out += window.katex.renderToString(parts[i], { throwOnError: false, displayMode: false })
              out += parts[i + 1] || ''
            }
            return out
          } catch (e) { return str }
        },
      }))
    })
  </script>
</Layout>
