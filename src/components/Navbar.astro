---
const base = import.meta.env.BASE_URL
const navLinks = [
  { href: base, label: 'Home', icon: 'ph ph-house' },
  { href: base + '/decision-graph', label: 'Decision Graph', icon: 'ph ph-flow-arrow' },
  { href: base + '/explorer', label: 'Explorer', icon: 'ph ph-table' },
  { href: base + '/cost-analysis', label: 'Cost Analysis', icon: 'ph ph-chart-bar' },
  { href: base + '/genealogy', label: 'Genealogy', icon: 'ph ph-tree-structure' },
  { href: base + '/mpc-puzzle', label: 'MPC Puzzle', icon: 'ph ph-puzzle-piece' },
  { href: base + '/related-work', label: 'Related Work', icon: 'ph ph-books' },
  { href: base + '/bibliography', label: 'Bibliography', icon: 'ph ph-books' },
  { href: base + '/contribute', label: 'Contribute', icon: 'ph ph-git-pull-request' },
]
const currentPath = Astro.url.pathname
---
<nav class="sticky top-0 z-50 bg-navy-950/90 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">S</div>
        <div class="hidden sm:block leading-none">
          <div class="text-white font-bold text-sm">SoK PPML-MPC</div>
          <div class="text-slate-500 text-xs mt-0.5">Framework Tracker</div>
        </div>
      </a>
      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-0.5">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== base && currentPath.startsWith(link.href))
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors ${
                isActive
                  ? 'bg-brand-500/15 text-brand-400'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'
              }`}
            >
              {link.label}
            </a>
          )
        })}
      </div>
      <!-- Actions -->
      <div class="flex items-center gap-2">
        <a
          href="https://eprint.iacr.org/2025/1679"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium border border-slate-700 rounded-lg text-slate-400 hover:border-brand-500 hover:text-brand-400 transition-colors"
        >
          <i class="ph ph-file-pdf text-sm"></i>
          Paper
        </a>
        <a
          href="https://github.com/KULeuven-COSIC/sok-ppml-mpc-frameworks"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium border border-slate-700 rounded-lg text-slate-400 hover:border-slate-500 hover:text-slate-200 transition-colors"
        >
          <i class="ph ph-github-logo text-sm"></i>
          <span class="hidden sm:inline">GitHub</span>
        </a>
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800"
          aria-label="Menu"
        >
          <i class="ph ph-list text-xl"></i>
        </button>
      </div>
    </div>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-navy-950">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800"
        >
          <i class={link.icon}></i>
          {link.label}
        </a>
      ))}
      <a href="https://eprint.iacr.org/2025/1679" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800">
        <i class="ph ph-file-pdf"></i> Read Paper
      </a>
    </div>
  </div>
</nav>
<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden')
  })
</script>
